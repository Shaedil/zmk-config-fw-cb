ble: allow turning Bluetooth off at runtime

zmk_ble_set_enabled(false) stops advertising and drops peripheral
connections; bonds and the active profile are kept.  For the Framework
Control Board's wired/Bluetooth switch (src/mode_switch.c).

Applies to petejohanson/zmk 5565f21, on top of 0001.

diff --git a/app/include/zmk/ble.h b/app/include/zmk/ble.h
index 92b2107..fe6b836 100644
--- a/app/include/zmk/ble.h
+++ b/app/include/zmk/ble.h
@@ -44,6 +44,10 @@ int zmk_ble_unpair_all(void);
 
 int zmk_ble_set_device_name(char *name);
 
+// While off: no advertising, peripheral connections dropped, bonds kept
+int zmk_ble_set_enabled(bool enabled);
+bool zmk_ble_is_enabled(void);
+
 #if IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL)
 int zmk_ble_put_peripheral_addr(const bt_addr_le_t *addr);
 #endif /* IS_ENABLED(CONFIG_ZMK_SPLIT_ROLE_CENTRAL) */
diff --git a/app/src/ble.c b/app/src/ble.c
index bd2fbe4..f6699c2 100644
--- a/app/src/ble.c
+++ b/app/src/ble.c
@@ -55,6 +55,8 @@ enum advertising_type {
 
 #define CURR_ADV(adv) (adv << 4)
 
+static bool ble_enabled = true;
+
 #define ZMK_ADV_CONN_NAME                                                                          \
     BT_LE_ADV_PARAM(BT_LE_ADV_OPT_CONN, BT_GAP_ADV_FAST_INT_MIN_1, BT_GAP_ADV_FAST_INT_MAX_1, NULL)
 
@@ -214,7 +216,9 @@ int update_advertising(void) {
     int err = 0;
     enum advertising_type desired_adv = ZMK_ADV_NONE;
 
-    if (zmk_ble_active_profile_is_open()) {
+    if (!ble_enabled) {
+        desired_adv = ZMK_ADV_NONE;
+    } else if (zmk_ble_active_profile_is_open()) {
         desired_adv = ZMK_ADV_CONN;
     } else if (!zmk_ble_active_profile_is_connected()) {
         desired_adv = ZMK_ADV_CONN;
@@ -278,6 +282,30 @@ static void update_advertising_callback(struct k_work *work) { update_advertisin
 
 K_WORK_DEFINE(update_advertising_work, update_advertising_callback);
 
+static void disconnect_peripheral_conn(struct bt_conn *conn, void *data) {
+    struct bt_conn_info info;
+
+    if (bt_conn_get_info(conn, &info) == 0 && info.role == BT_CONN_ROLE_PERIPHERAL) {
+        bt_conn_disconnect(conn, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+    }
+}
+
+int zmk_ble_set_enabled(bool enabled) {
+    if (ble_enabled == enabled) {
+        return 0;
+    }
+
+    ble_enabled = enabled;
+
+    if (!enabled) {
+        bt_conn_foreach(BT_CONN_TYPE_LE, disconnect_peripheral_conn, NULL);
+    }
+
+    return update_advertising();
+}
+
+bool zmk_ble_is_enabled(void) { return ble_enabled; }
+
